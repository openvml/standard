<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenVML (Open Voice Markup Language) 2.2 — structural XSD
  Canonical schema reference (see reference/validation.md, section 9).

  This schema is STRUCTURAL and project-type agnostic:
  it describes the XML shape, allowed values, identifiers and references.
  Semantic interpretation and runtime behavior belong to the conforming Player.

  Per the Standard, unknown elements and attributes SHOULD be ignored rather
  than rejected (forward compatibility). Where a reference document leaves a
  value open (e.g. emotion, role, timbre), this schema uses xs:string.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <!-- ============================================================
         Simple types
    ============================================================ -->

    <xs:simpleType name="startModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="afterPrevious"/>
            <xs:enumeration value="absolute"/>
            <xs:enumeration value="duringCurrent"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="layerType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="background"/>
            <xs:enumeration value="foreground"/>
            <xs:enumeration value="overlay"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="positionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="left"/>
            <xs:enumeration value="right"/>
            <xs:enumeration value="center"/>
            <xs:enumeration value="offscreen-left"/>
            <xs:enumeration value="offscreen-right"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="textAlignType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="left"/>
            <xs:enumeration value="center"/>
            <xs:enumeration value="right"/>
            <xs:enumeration value="justify"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="wordByWordModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="single"/>
            <xs:enumeration value="cumulative"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="transitionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="fade"/>
            <xs:enumeration value="dissolve"/>
            <xs:enumeration value="cut"/>
            <xs:enumeration value="slide-left"/>
            <xs:enumeration value="slide-right"/>
            <xs:enumeration value="slide-up"/>
            <xs:enumeration value="slide-down"/>
            <xs:enumeration value="zoom-in"/>
            <xs:enumeration value="zoom-out"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="sceneTransitionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="fade"/>
            <xs:enumeration value="cut"/>
            <xs:enumeration value="dissolve"/>
            <xs:enumeration value="wipe"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="timeOfDayType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="morning"/>
            <xs:enumeration value="afternoon"/>
            <xs:enumeration value="evening"/>
            <xs:enumeration value="night"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="weatherType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="clear"/>
            <xs:enumeration value="cloudy"/>
            <xs:enumeration value="rainy"/>
            <xs:enumeration value="foggy"/>
            <xs:enumeration value="snowy"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="moodType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="calm"/>
            <xs:enumeration value="tense"/>
            <xs:enumeration value="mysterious"/>
            <xs:enumeration value="romantic"/>
            <xs:enumeration value="dramatic"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="fitModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="fit"/>
            <xs:enumeration value="fill"/>
            <xs:enumeration value="stretch"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="overlayModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="percent"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="subtitleTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="srt"/>
            <xs:enumeration value="vtt"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="inventoryItemTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="clothing"/>
            <xs:enumeration value="equipment"/>
            <xs:enumeration value="object"/>
            <xs:enumeration value="trace"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="inventoryItemStateType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="worn"/>
            <xs:enumeration value="removed"/>
            <xs:enumeration value="carried"/>
            <xs:enumeration value="dropped"/>
            <xs:enumeration value="damaged"/>
            <xs:enumeration value="lost"/>
            <xs:enumeration value="active"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="conditionStateType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="active"/>
            <xs:enumeration value="healing"/>
            <xs:enumeration value="healed"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="postureType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="standing"/>
            <xs:enumeration value="sitting"/>
            <xs:enumeration value="lying"/>
            <xs:enumeration value="kneeling"/>
            <xs:enumeration value="crouching"/>
            <xs:enumeration value="leaning"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="movementType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="stationary"/>
            <xs:enumeration value="walking"/>
            <xs:enumeration value="running"/>
            <xs:enumeration value="climbing"/>
            <xs:enumeration value="swimming"/>
            <xs:enumeration value="flying"/>
            <xs:enumeration value="driving"/>
            <xs:enumeration value="riding"/>
            <xs:enumeration value="traveling"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="activityType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="reading"/>
            <xs:enumeration value="writing"/>
            <xs:enumeration value="talking"/>
            <xs:enumeration value="eating"/>
            <xs:enumeration value="sleeping"/>
            <xs:enumeration value="fighting"/>
            <xs:enumeration value="working"/>
            <xs:enumeration value="observing"/>
            <xs:enumeration value="operating"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="transportTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="car"/>
            <xs:enumeration value="motorcycle"/>
            <xs:enumeration value="bus"/>
            <xs:enumeration value="truck"/>
            <xs:enumeration value="train"/>
            <xs:enumeration value="aircraft"/>
            <xs:enumeration value="helicopter"/>
            <xs:enumeration value="boat"/>
            <xs:enumeration value="ship"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="secondsType">
        <xs:restriction base="xs:float">
            <xs:minInclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="millisecondsType">
        <xs:restriction base="xs:float">
            <xs:minInclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ============================================================
         Shared attribute groups
    ============================================================ -->

    <xs:attributeGroup name="timingAttrs">
        <xs:attribute name="startMode" type="startModeType" default="afterPrevious"/>
        <xs:attribute name="startTime" type="xs:float"/>
        <xs:attribute name="startDelay" type="xs:float"/>
        <xs:attribute name="duration" type="xs:float"/>
        <xs:attribute name="trimStart" type="xs:float"/>
        <xs:attribute name="loop" type="xs:boolean"/>
    </xs:attributeGroup>

    <xs:attributeGroup name="gridAttrs">
        <xs:attribute name="gridRow" type="xs:integer"/>
        <xs:attribute name="gridCol" type="xs:integer"/>
        <xs:attribute name="gridRowSpan" type="xs:integer"/>
        <xs:attribute name="gridColSpan" type="xs:integer"/>
    </xs:attributeGroup>

    <xs:attributeGroup name="voiceParamsAttrs">
        <xs:attribute name="pitch" type="xs:string"/>
        <xs:attribute name="rate" type="xs:string"/>
        <xs:attribute name="volume" type="xs:string"/>
        <xs:attribute name="timbre" type="xs:string"/>
    </xs:attributeGroup>

    <!-- Permission-slot placeholders for forward compatibility. -->
    <xs:attributeGroup name="forwardCompatAttrs">
        <xs:anyAttribute processContents="lax"/>
    </xs:attributeGroup>

    <!-- ============================================================
         Processing directives (global, reusable)
    ============================================================ -->

    <!-- <color> — color correction -->
    <xs:element name="color">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="brightness" type="xs:float" minOccurs="0"/>
                <xs:element name="contrast" type="xs:float" minOccurs="0"/>
                <xs:element name="saturation" type="xs:float" minOccurs="0"/>
                <xs:element name="hue" type="xs:float" minOccurs="0"/>
                <xs:element name="gamma" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <grayscale> -->
    <xs:element name="grayscale">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="intensity" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <invert> -->
    <xs:element name="invert">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="intensity" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <sepia> -->
    <xs:element name="sepia">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="intensity" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <blur> -->
    <xs:element name="blur">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="radius" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <sharpen> -->
    <xs:element name="sharpen">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="amount" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <rotate> -->
    <xs:element name="rotate">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="angle" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <flip> — attribute form and child-element form are both accepted -->
    <xs:element name="flip">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="horizontal" type="xs:boolean" minOccurs="0"/>
                <xs:element name="vertical" type="xs:boolean" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attribute name="horizontal" type="xs:boolean"/>
            <xs:attribute name="vertical" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <crop> -->
    <xs:element name="crop">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="x" type="xs:float" minOccurs="0"/>
                <xs:element name="y" type="xs:float" minOccurs="0"/>
                <xs:element name="width" type="xs:float" minOccurs="0"/>
                <xs:element name="height" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <resize> — video form (mode) and image form (keep_aspect) both accepted -->
    <xs:element name="resize">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="width" type="xs:int" minOccurs="0"/>
                <xs:element name="height" type="xs:int" minOccurs="0"/>
                <xs:element name="mode" type="fitModeType" minOccurs="0"/>
                <xs:element name="keep_aspect" type="xs:boolean" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <speed> (video) -->
    <xs:element name="speed">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="factor" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <fade> -->
    <xs:element name="fade">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="in_duration" type="secondsType" minOccurs="0"/>
                <xs:element name="out_duration" type="secondsType" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <overlay> -->
    <xs:element name="overlay">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="src" type="xs:string" minOccurs="0"/>
                <xs:element name="opacity" type="xs:float" minOccurs="0"/>
                <xs:element name="x" type="xs:float" minOccurs="0"/>
                <xs:element name="y" type="xs:float" minOccurs="0"/>
                <xs:element name="width" type="xs:float" minOccurs="0"/>
                <xs:element name="height" type="xs:float" minOccurs="0"/>
                <xs:element name="mode" type="overlayModeType" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <chroma_key> (video) -->
    <xs:element name="chroma_key">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="similarity" type="xs:float" minOccurs="0"/>
                <xs:element name="color" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <text> (video) -->
    <xs:element name="text">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="content" type="xs:string" minOccurs="0"/>
                <xs:element name="size" type="xs:float" minOccurs="0"/>
                <xs:element name="color" type="xs:string" minOccurs="0"/>
                <xs:element name="font" type="xs:string" minOccurs="0"/>
                <xs:element name="x" type="xs:float" minOccurs="0"/>
                <xs:element name="y" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <convert> -->
    <xs:element name="convert">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="format" type="xs:string" minOccurs="0"/>
                <xs:element name="codec" type="xs:string" minOccurs="0"/>
                <xs:element name="quality" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <eq> and <band> (audio) -->
    <xs:element name="band">
        <xs:complexType>
            <xs:attribute name="hz" type="xs:float"/>
            <xs:attribute name="gain_db" type="xs:float"/>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="eq">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="band" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <compressor> (audio) -->
    <xs:element name="compressor">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="threshold" type="xs:float" minOccurs="0"/>
                <xs:element name="ratio" type="xs:float" minOccurs="0"/>
                <xs:element name="attack" type="xs:float" minOccurs="0"/>
                <xs:element name="release" type="xs:float" minOccurs="0"/>
                <xs:element name="knee" type="xs:float" minOccurs="0"/>
                <xs:element name="makeup_gain" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- <gain> (audio) -->
    <xs:element name="gain">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="db" type="xs:float" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:boolean"/>
            <xs:attributeGroup ref="forwardCompatAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- Processing container types -->
    <xs:complexType name="VideoProcessingType">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="color"/>
                <xs:element ref="grayscale"/>
                <xs:element ref="invert"/>
                <xs:element ref="sepia"/>
                <xs:element ref="blur"/>
                <xs:element ref="sharpen"/>
                <xs:element ref="rotate"/>
                <xs:element ref="flip"/>
                <xs:element ref="crop"/>
                <xs:element ref="resize"/>
                <xs:element ref="speed"/>
                <xs:element ref="fade"/>
                <xs:element ref="overlay"/>
                <xs:element ref="chroma_key"/>
                <xs:element ref="text"/>
                <xs:element ref="convert"/>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean"/>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="ImageProcessingType">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="color"/>
                <xs:element ref="grayscale"/>
                <xs:element ref="invert"/>
                <xs:element ref="sepia"/>
                <xs:element ref="blur"/>
                <xs:element ref="sharpen"/>
                <xs:element ref="rotate"/>
                <xs:element ref="flip"/>
                <xs:element ref="crop"/>
                <xs:element ref="resize"/>
                <xs:element ref="fade"/>
                <xs:element ref="overlay"/>
                <xs:element ref="convert"/>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean"/>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="AudioProcessingType">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="eq"/>
                <xs:element ref="compressor"/>
                <xs:element ref="gain"/>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean"/>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <!-- ============================================================
         <meta>
    ============================================================ -->

    <xs:complexType name="PreferencesType">
        <xs:sequence>
            <xs:element name="showSubtitles" type="xs:boolean" minOccurs="0"/>
            <xs:element name="subtitleFontSize" type="xs:integer" minOccurs="0"/>
            <xs:element name="subtitleBg" type="xs:string" minOccurs="0"/>
            <xs:element name="subtitleColor" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="MetaVideoType">
        <xs:sequence>
            <xs:element name="aspect_ratio" type="xs:string" minOccurs="0"/>
            <xs:element name="resolution" type="xs:string" minOccurs="0"/>
            <xs:element name="fps" type="xs:float" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="MetaType">
        <xs:sequence>
            <xs:element name="title" type="xs:string" minOccurs="0"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="narrator" type="xs:string" minOccurs="0"/>
            <xs:element name="language" type="xs:string" minOccurs="0"/>
            <xs:element name="preferences" type="PreferencesType" minOccurs="0"/>
            <xs:element name="video" type="MetaVideoType" minOccurs="0"/>
            <xs:any processContents="lax" namespace="##any" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <!-- ============================================================
         <settings>
    ============================================================ -->

    <xs:complexType name="TtsType">
        <xs:sequence>
            <xs:element name="engine" type="xs:string" minOccurs="0"/>
            <xs:element name="default_language" type="xs:string" minOccurs="0"/>
            <xs:element name="default_voice" type="xs:string" minOccurs="0"/>
            <xs:element name="default_speed" type="xs:float" minOccurs="0"/>
            <xs:element name="default_pitch" type="xs:float" minOccurs="0"/>
            <xs:element name="default_volume" type="xs:float" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="RenderType">
        <xs:sequence>
            <xs:element name="output_format" type="xs:string" minOccurs="0"/>
            <xs:element name="bitrate" type="xs:string" minOccurs="0"/>
            <xs:element name="sample_rate" type="xs:integer" minOccurs="0"/>
            <xs:element name="channels" type="xs:integer" minOccurs="0"/>
            <xs:element name="normalize_audio" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="MarkersType">
        <xs:sequence>
            <xs:element name="enable_chapters" type="xs:boolean" minOccurs="0"/>
            <xs:element name="enable_cue_sheets" type="xs:boolean" minOccurs="0"/>
            <xs:element name="chapter_image_format" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="SettingsTransitionsType">
        <xs:sequence>
            <xs:element name="default" type="sceneTransitionType" minOccurs="0"/>
            <xs:element name="duration" type="xs:float" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="forwardCompatAttrs"/>
    </xs:complexType>

    <xs:complexType name="SettingsType">
        <xs:sequence>
            <xs:element name="tts" type="TtsType" minOccurs="0"/>
            <xs:element name="render" type="RenderType" minOccurs="0"/>
            <xs:element name="markers" type="MarkersType" minOccurs="0"/>
            <xs:element name="transitions" type="SettingsTransitionsType" minOccurs="0"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="audio_processing" type="AudioProcessingType"/>
                <xs:element name="video_processing" type="VideoProcessingType"/>
