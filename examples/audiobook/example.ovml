<?xml version="1.0" encoding="UTF-8"?>
<ovml version="2.3" lang="en">
  <meta>
    <title>The Lantern Keeper and the Lost Bell</title>
    <author>OpenVML Example</author>
  </meta>

  <cast>
    <character id="narrator" name="Narrator" color="#6b7280"
      role="narrator" gender="neutral" age="adult"
      voiceEngine="edge_tts"
      voiceName="Warm, measured, and unhurried."
      voiceLang="en-US"
      pitch="1" rate="1"/>
    <character id="jonas" name="Jonas" color="#d2691e"
      role="major" gender="male" age="elderly"
      voiceEngine="edge_tts"
      voiceName="Deep, rumbling, and weathered."
      voiceLang="en-US"
      pitch="0.9" rate="0.95"
      aliases="the old man|the keeper|the lantern keeper"
      personality="Patient, stoic, protective of the light."
      backstory="Lighthouse keeper of Black Point for forty years."/>
    <character id="marta" name="Marta" color="#ff69b4"
      role="major" gender="female" age="child"
      voiceEngine="edge_tts"
      voiceName="Bright, eager, slightly breathless."
      voiceLang="en-US"
      pitch="1.15" rate="1.05"
      aliases="the girl|the child|twelve-year-old Marta"
      personality="Determined, resourceful, hopeful."
      backstory="A young girl of the harbor town, devoted to the chapel bell."/>
    <character id="eli" name="Eli" color="#4169e1"
      role="major" gender="male" age="adult"
      voiceEngine="edge_tts"
      voiceName="Easy, warm, and unhurried."
      voiceLang="en-US"
      pitch="1.05" rate="1"
      aliases="the young fisherman|the captain"
      personality="Good-natured, practical, loyal to the harbor."
      backstory="Owner and captain of the Morning Star fishing boat."/>
  </cast>

  <assets>
    <audio id="music" type="music" name="Ocean Night Theme"
      src="https://example.com/assets/ocean_night.mp3"
      loop="true"/>
    <audio id="chapel_bell" type="sfx" name="Chapel Bell"
      src="https://example.com/assets/chapel_bell.mp3"/>
  </assets>

  <script>
    <chapter id="ch_01" title="The Night Wind">

      <scene title="The Lighthouse" atmosphere="stormy, wild sea at night"
        color="#1a1a2e">
        <location>The keeper's lighthouse above Black Point</location>

        <audio src="#music" action="background" volume="0.2"/>

        <p>
          <line char="narrator">Old Jonas tended the lighthouse at Black Point for forty years, high above a town that had almost forgotten the sea.</line>
        </p>

        <break duration="600"/>

        <p>
          <line char="narrator">Every evening at dusk he climbed the iron stairs, lit the great lamp, and let its beam sweep the dark water like a long, slow question.</line>
        </p>

        <break duration="800"/>

        <p>
          <line char="narrator">One autumn night, as the wind rose and the rain set in, a small figure knocked on the keeper's door. It was twelve-year-old Marta, drenched to the skin, clutching a copper bell that had come loose from the harbor chapel.</line>
        </p>

        <break duration="500"/>

        <p>
          <line char="marta" intonation="excited">Jonas,</line>
          <line char="marta">she said, breathless,</line>
          <line char="marta" intonation="statement">the bell fell during the storm. Without it, the ships can't hear us through the fog.</line>
        </p>
      </scene>

      <scene title="The Argument" atmosphere="quiet, lamp-lit, rain on the windows">
        <location>Inside the keeper's cottage</location>

        <p>
          <line char="narrator">The old man studied her for a long moment, then shook his head.</line>
        </p>

        <break duration="600"/>

        <p>
          <line char="jonas" intonation="statement">That bell isn't mine to ring,</line>
          <line char="jonas">he said gently.</line>
          <line char="jonas" intonation="statement">I keep the light, child. The captain of the Morning Star is the only one who decides what the harbor hears.</line>
        </p>

        <break duration="500"/>

        <p>
          <line char="marta" intonation="excited">Then let the light speak for it,</line>
          <line char="marta">Marta argued, setting the bell on the table with a soft, flat clang.</line>
          <line char="marta" intonation="statement">The beam reaches farther than any voice.</line>
        </p>

        <break duration="500"/>

        <p>
          <line char="narrator">From the doorway came a low chuckle.</line>
          <line char="eli" intonation="amused">She's got a point, Jonas. That lamp has brought a hundred boats home. A bell that rings on the shore can't do what your light does on the sea.</line>
        </p>

        <break duration="600"/>

        <p>
          <line char="jonas" intonation="statement">Light is for guiding,</line>
          <line char="jonas">he rumbled.</line>
          <line char="jonas" intonation="statement">Bell is for warning. Both matter, if you know when to use them.</line>
        </p>
      </scene>

      <scene title="The Fog" atmosphere="dense fog, waiting, patience">
        <location>The harbor and the lighthouse stairs</location>

        <p>
          <line char="marta">Marta picked up her bell and hurried to the chapel.</line>
          <line char="narrator">Jonas trimmed his lamp and returned to his watch.</line>
        </p>

        <break duration="700"/>

        <p>
          <line char="narrator">It was not long before the fog closed in, thick and white, and the shore bell began to ring — steady, patient, over and over.</line>
        </p>

        <break duration="600"/>

        <audio src="#chapel_bell" action="sfx" volume="0.5"/>

        <p>
          <line char="narrator">In the morning, the Morning Star came home through the mist, her sails crisp with dew, her deck bright with lantern-light.</line>
        </p>

        <break duration="500"/>

        <p>
          <line char="narrator">And the old keeper understood at last that a keeper need not be the one who rings. He needed only to tend the flame that made the ringing matter.</line>
        </p>
      </scene>

      <scene title="The Copper Bell" atmosphere="gentle, resolved, peaceful dawn">
        <location>The foot of the lighthouse stairs</location>

        <p>
          <line char="narrator">That night, Jonas hung the copper bell at the foot of the lighthouse stairs — a small, gleaming promise — and went up to light the lamp, as he had every night for forty years.</line>
        </p>
      </scene>
    </chapter>
  </script>
</ovml>
